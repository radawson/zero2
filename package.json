{
    "name": "zero",
    "version": "0.1.0",
    "private": true,
    "bin": {
        "voice-test": "scripts/voice-test.js"
    },
    "scripts": {
        "dev": "next dev -H 0.0.0.0 -p 3001",
        "build": "next build",
        "build:static": "STATIC_EXPORT=true next build",
        "build:production": "STATIC_EXPORT=true next build && npm run package:production",
        "package:production": "cd out && zip -r ../travelcourse-$npm_package_version.zip . && cd ..",
        "start": "next start",
        "lint": "next lint",
        "lint:fix": "next lint --fix",
        "test": "jest --watch",
        "test:ci": "jest --ci",
        "test:coverage": "jest --coverage",
        "generate:course-structure": "tsx scripts/generate-course-structure.ts",
        "voice-test": "tsx scripts/voice-tester.ts",
        "db:seed": "npx prisma db seed",
        "preversion": "npm test",
        "version": "npm run build:production",
        "postversion": "git push && git push --tags && echo '✅ Version bumped, built, and pushed!'"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.11.1",
        "@prisma/adapter-pg": "^7.3.0",
        "@prisma/client": "^7.3.0",
        "axios": "^1.13.4",
        "framer-motion": "^12.30.0",
        "jspdf": "^4.1.0",
        "jspdf-autotable": "^5.0.7",
        "mdx-bundler": "^10.1.1",
        "next": "16.1.6",
        "next-auth": "^4.24.13",
        "pg": "^8.18.0",
        "prisma": "^7.3.0",
        "radix-ui": "^1.4.3",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-icons": "^5.5.0",
        "rehype-highlight": "^7.0.2",
        "server-only": "^0.0.1",
        "stripe": "^20.3.0",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@eslint/eslintrc": "3.3.3",
        "@google-cloud/text-to-speech": "^6.4.0",
        "@tailwindcss/postcss": "4.1.18",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.2.0",
        "@types/react": "19.2.10",
        "@types/react-dom": "^19.2.3",
        "beasties": "0.4.1",
        "commander": "^14.0.3",
        "dotenv": "^17.2.3",
        "eslint": "9.39.2",
        "eslint-config-next": "16.1.6",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "openapi-typescript-codegen": "^0.30.0",
        "play-sound": "^1.1.6",
        "tailwindcss": "4.1.18",
        "tsx": "^4.21.0",
        "typescript": "5.9.3"
    },
    "engines": {
        "node": ">=18.18.0"
    }
}
